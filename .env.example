# Copy this file to .env (same folder as README.md) and fill in your keys.
# NEVER commit .env to GitHub (it is already in .gitignore).

# true  = dummy data everywhere (recommended for the demo)
# false = YouTube accounts are fetched live (needs YOUTUBE_API_KEY); Instagram/Facebook stay demo
DEMO_MODE=true

# Get it free at https://aistudio.google.com/apikey  -> enables the real Gemma model.
# Leave empty and the app still works using a rule-based offline fallback.
GEMINI_API_KEY=

# Gemma 4 models on the Gemini API: gemma-4-26b-a4b-it (fast) or gemma-4-31b-it (stronger)
GEMMA_MODEL=gemma-4-26b-a4b-it

# Only needed when DEMO_MODE=false. Google Cloud Console -> enable "YouTube Data API v3" -> Credentials -> API key
YOUTUBE_API_KEY=
